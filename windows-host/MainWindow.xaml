<Window x:Class="Yuyin.WindowsHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="open音乐"
        Width="1440"
        Height="950"
        MinWidth="1080"
        MinHeight="680"
        Background="#F7F8F5"
        Icon="icon.ico"
        Loaded="Window_Loaded"
        Closing="Window_Closing">
    <Grid>
        <wv2:WebView2 x:Name="Browser" />
        <Border x:Name="StartupOverlay" Background="#F7F8F5" Visibility="Visible">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Margin="32">
                <TextBlock x:Name="StatusText" Foreground="#667267" Text="正在启动open音乐…" TextWrapping="Wrap" />
                <Button x:Name="RuntimeDownloadButton" Content="安装系统 WebView2 运行时" Visibility="Collapsed"
                        HorizontalAlignment="Center" Margin="0,18,0,0" Padding="16,8" Click="RuntimeDownloadButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
