<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Yuyin.WindowsHost</AssemblyName>
    <RootNamespace>Yuyin.WindowsHost</RootNamespace>
    <ApplicationIcon>../build/icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <None Update="bridge.js" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="../build/icon.ico" Link="icon.ico" />
  </ItemGroup>
</Project>
